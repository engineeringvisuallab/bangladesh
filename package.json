{
  "name": "evworld",
  "private": true,
  "version": "0.1.0",
  "description": "Open-world driving game on real Bangladesh geography. One national coordinate system; cities are added as regions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:geo": "tsx scripts/geo-test.ts",
    "test:roads": "tsx scripts/roads-test.ts",
    "test": "npm run test:geo && npm run test:roads"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
